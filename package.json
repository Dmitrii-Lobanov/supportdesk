{
  "name": "supportdesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev:customers": "node --watch mocks/customer-api.js",
    "test": "node --test tests/analysis.test.ts tests/customer-api.test.ts",
    "test:backend": "vitest run",
    "test:all": "npm test && npm run test:backend",
    "dev:worker": "wrangler dev",
    "deploy:customers": "wrangler deploy",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@clerk/react": "^6.18.1",
    "@radix-ui/react-select": "^2.4.1",
    "convex": "^1.48.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.65",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
